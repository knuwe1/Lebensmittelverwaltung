# Kopieren nach .env und anpassen. Die Datei .env niemals committen.

# Datenbank (Passwort nur mit Buchstaben/Ziffern, da es Teil einer URL ist)
POSTGRES_USER=lmv
POSTGRES_PASSWORD=bitteaendern
POSTGRES_DB=lmv

# Zufälliger Schlüssel für Sitzungen, z. B. erzeugt mit: openssl rand -hex 32
LMV_SECRET_KEY=

# Erster Administrator – wird nur angelegt, solange noch kein Benutzer existiert.
LMV_BOOTSTRAP_ADMIN_USERNAME=admin
LMV_BOOTSTRAP_ADMIN_PASSWORD=
LMV_BOOTSTRAP_HOUSEHOLD_NAME=Mein Haushalt

# Erreichbarkeit / HTTPS (siehe docs/BETRIEB.md)
# Empfohlen: Tailscale. LMV_SITE_ADDRESS = MagicDNS-Name des Hosts im Tailnet.
LMV_SITE_ADDRESS=vorrat.tailXXXXX.ts.net
LMV_TLS_MODE=tailscale
COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml
# Empfohlen bei Tailscale: nur über die Tailscale-IP des Hosts erreichbar machen (Ausgabe von
# `tailscale ip -4`). Leer = alle Schnittstellen, also auch aus dem WLAN/LAN erreichbar.
LMV_BIND_ADDRESS=
LMV_HTTP_PORT=80
LMV_HTTPS_PORT=443
# Nur für LMV_TLS_MODE=internal und Aufruf per IP-Adresse (z. B. Test im WLAN)
LMV_DEFAULT_SNI=
# Nur für LMV_TLS_MODE=acme (öffentliche Domain mit Let's Encrypt)
LMV_ACME_EMAIL=

# Version der Container-Images (Release-Version ohne "v", oder latest)
LMV_VERSION=latest

# Datensicherung
LMV_BACKUP_DIR=./backups
LMV_BACKUP_TIME=03:00
LMV_BACKUP_KEEP_DAYS=14
TZ=Europe/Berlin
